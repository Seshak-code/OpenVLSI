{
  "scenario": "voltage_divider_dc",
  "description": "Two equal resistors (10kΩ each) between 5V and GND. DC steady-state: Vmid = 2.5V.",
  "steps": [
    {
      "op": "placeComponent",
      "id": "V1",
      "type": "VoltageSource",
      "pos": [100, 200],
      "rot": 0,
      "params": { "voltage": "5", "n+": "vdd", "n-": "gnd" }
    },
    {
      "op": "placeComponent",
      "id": "R1",
      "type": "Resistor",
      "pos": [300, 200],
      "rot": 0,
      "params": { "resistance": "10000", "n+": "vdd", "n-": "vmid" }
    },
    {
      "op": "placeComponent",
      "id": "R2",
      "type": "Resistor",
      "pos": [500, 200],
      "rot": 0,
      "params": { "resistance": "10000", "n+": "vmid", "n-": "gnd" }
    },
    {
      "op": "placeComponent",
      "id": "GND",
      "type": "Ground",
      "pos": [100, 350],
      "rot": 0,
      "params": { "net": "gnd" }
    },
    {
      "op": "placeComponent",
      "id": "P1",
      "type": "Probe",
      "pos": [420, 150],
      "rot": 0,
      "params": { "n+": "vmid", "n-": "gnd" }
    },
    {
      "op": "runSimulation",
      "analysis": "DC",
      "params": {},
      "timeoutMs": 10000
    },
    {
      "op": "assertProbe",
      "probe": "P1",
      "expected": 2.5,
      "tolerance": 0.1
    }
  ]
}
