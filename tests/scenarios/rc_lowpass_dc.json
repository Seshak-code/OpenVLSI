{
  "scenario": "RC_lowpass_dc",
  "description": "R=1kΩ + C=1µF with 5V supply. DC steady-state: capacitor is open-circuit, Vout = Vsupply = 5V.",
  "steps": [
    {
      "op": "placeComponent",
      "id": "V1",
      "type": "VoltageSource",
      "pos": [100, 200],
      "rot": 0,
      "params": { "voltage": "5", "n+": "vdd", "n-": "gnd" }
    },
    {
      "op": "placeComponent",
      "id": "R1",
      "type": "Resistor",
      "pos": [300, 200],
      "rot": 0,
      "params": { "resistance": "1000", "n+": "vdd", "n-": "vout" }
    },
    {
      "op": "placeComponent",
      "id": "C1",
      "type": "Capacitor",
      "pos": [500, 300],
      "rot": 0,
      "params": { "capacitance": "1e-6", "n+": "vout", "n-": "gnd" }
    },
    {
      "op": "placeComponent",
      "id": "GND",
      "type": "Ground",
      "pos": [100, 350],
      "rot": 0,
      "params": { "net": "gnd" }
    },
    {
      "op": "placeComponent",
      "id": "P1",
      "type": "Probe",
      "pos": [500, 150],
      "rot": 0,
      "params": { "n+": "vout", "n-": "gnd" }
    },
    {
      "op": "runSimulation",
      "analysis": "DC",
      "params": {},
      "timeoutMs": 10000
    },
    {
      "op": "assertProbe",
      "probe": "P1",
      "expected": 5.0,
      "tolerance": 0.05
    }
  ]
}
